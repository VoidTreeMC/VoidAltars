AltarTable
==========
  uuid:                     VARCHAR(36)
  type:                     Varchar(16)
  town_uuid:                Varchar(36)
  world:                    Varchar(32)
  level:                    TINYINT
  x:                        INT
  y:                        INT
  z:                        INT
  boon_1:                   Varchar(16)
  boon_2:                   Varchar(16)
  boon_3:                   Varchar(16)
  boon_4:                   Varchar(16)
  sacrifice_1:              BLOB
  sacrifice_2:              BLOB
  sacrifice_3:              BLOB
  sacrifice_4:              BLOB
  total_recent_sacrifices:  INT
  total_sacrifices_made:    INT
  next_eval_time:           BIGINT

SacrificeTable
==============
  time:                     BIGINT
  town_uuid:                Varchar(36)
  player_uuid:              Varchar(36)
  altar_id:                 INT
  altar_type:               VarChar(16)
  altar_level:              TINYINT
  item_type:                Varchar(40)
  amount:                   INT
  amount_remaining:         INT

SELECT uuid,type,town_uuid,world,level,x,y,z,boon_1,boon_2,boon_3,boon_4,total_recent_sacrifices,total_sacrifices_made,next_eval_time FROM AltarTable;
